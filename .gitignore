# v0 sandbox internal files
__v0_runtime_loader.js
__v0_devtools.tsx
__v0_jsx-dev-runtime.ts
.snowflake/
.v0-trash/
.vercel/

# Environment variables — every .env* holds live credentials and stays local.
# The names are environments, not Next.js modes (.env.www, .env.dev), so that a
# production build cannot silently pick one up the way .env.production.local did.
.env*
!.env.local.example

# Common ignores
node_modules
.next/
.DS_Store
.vercel

# Generated build artifacts (Next.js / TypeScript)
next-env.d.ts
*.tsbuildinfo

# Claude Code local settings
.claude/settings.local.json
